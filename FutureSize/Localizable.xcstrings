{
  "sourceLanguage": "ru",
  "strings": {
    "home.title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будущий рост"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FutureSize"
          }
        }
      }
    },
    "home.subtitle": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка роста и веса на 10 лет по справочнику ВОЗ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 10-year height and weight estimate from the WHO reference"
          }
        }
      }
    },
    "home.empty.title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока никого нет"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No children yet"
          }
        }
      }
    },
    "home.empty.body": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте ребёнка и внесите хотя бы одно измерение. Прошлые годы, если они есть, делают оценку спокойнее."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a child and enter at least one measurement. Earlier years, if you have them, make the estimate steadier."
          }
        }
      }
    },
    "home.add": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить ребёнка"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a child"
          }
        }
      }
    },
    "home.example": {
      "localizations": {
