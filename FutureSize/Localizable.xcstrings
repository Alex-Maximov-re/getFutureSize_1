    "onboarding.accept": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понимаю и продолжаю"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand and continue"
          }
        }
      }
    },
    "onboarding.1.title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка на 10 лет"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A 10-year estimate"
          }
        }
      }
    },
    "onboarding.1.body": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение для родителей и опекунов. Введите возраст, рост и вес — сейчас и, если помните, за прошлые годы. Мы оценим, какими могут быть рост и вес через 10 лет, если ребёнок продолжит расти около своего перцентиля по справочнику ВОЗ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An app for parents and guardians. Enter age, height, and weight — current, and earlier years if you remember them. We estimate what height and weight may be in 10 years if the child keeps growing near their WHO percentile."
          }
        }
      }
    },
    "onboarding.2.title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошлые годы помогают"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earlier years help"
          }
        }
      }
    },
    "onboarding.2.body": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одного измерения достаточно для кривой. Два и больше показывают, смещается ли перцентиль. Этот сдвиг учитывается осторожно и затухает: он не продолжается бесконечной прямой."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One measurement is enough for a curve. Two or more show whether the percentile is moving. That shift is applied cautiously and then fades. It does not continue as an endless straight line."
          }
        }
      }
    },
    "onboarding.3.title": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не диагноз"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a diagnosis"
          }
        }
      }
    },
    "onboarding.3.body": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не диагноз и не медицинское изделие. Здесь нет роста родителей, срока полового созревания, болезней и питания. По этим цифрам нельзя лечить, назначать диету и решать, всё ли в порядке. Если что-то беспокоит — нужен педиатр."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a diagnosis and not a medical device. Parents’ height, the timing of puberty, illness, and food are not here. These figures cannot be used for treatment, a diet, or deciding that everything is fine. If something worries you, see a pediatrician."
          }
        }
      }
    },
